# =====================================================================
# Video Automation Pipeline - Environment Configuration
# =====================================================================

# --- 1. LLM / Script Generation ---
# Opciones de proveedor: gemini | deepseek
LLM_PROVIDER=gemini
GEMINI_API_KEY=tu_clave_gemini_aqui
DEEPSEEK_API_KEY=tu_clave_deepseek_aqui
DEEPSEEK_BASE_URL=https://api.deepseek.com

# --- 2. Síntesis de Voz (TTS) ---
# Opciones de proveedor: gemini | elevenlabs | edge-tts (gemini es hiper-expresivo con Gemini 3.8 Flash, edge-tts es gratuito)
TTS_PROVIDER=gemini
# Configuración Gemini 3.8 Flash TTS nativo
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
# Voces expresivas disponibles: Puck (enérgica), Charon (profunda), Aoede (cálida), Fenrir (autoritaria)
GEMINI_TTS_VOICE=Puck
# Fallback cascade para TTS:
GEMINI_TTS_FALLBACK_MODELS=gemini-3.8-flash-tts,gemini-3.8-flash-lite-tts,gemini-3.1-flash-tts-preview,gemini-2.5-flash-preview-tts

# ElevenLabs (opcional)
ELEVENLABS_API_KEY=tu_clave_elevenlabs_aqui
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Edge-TTS (fallback de alta velocidad)
# Voces recomendadas: es-MX-DaliaNeural (conversacional TikTok), es-MX-JorgeNeural, es-ES-AlvaroNeural
EDGE_TTS_VOICE=es-MX-DaliaNeural
EDGE_TTS_RATE=+10%

# Cadena de masterización acústica FFmpeg (High-Pass + EQ Boost + Compresión 3:1 + Loudnorm -14 LUFS)
ENABLE_AUDIO_MASTERING=true

# --- 3. Detección de Audio y Timestamps ---
WHISPER_MODEL=base
WHISPER_DEVICE=cpu

# --- 4. Generación de Imágenes ---
# Opciones: pollinations (gratis para test) | imagen (Google Imagen 3) | fal | replicate | stability
IMAGE_PROVIDER=pollinations
IMAGE_API_KEY=tu_clave_de_imagenes_aqui
IMAGE_ASPECT_RATIO=16:9

# --- 5. Montaje de Video (FFmpeg) y Duración ---
DEFAULT_DURATION_MINUTES=2.5     # Duración por defecto en minutos (ej: 2.0, 2.5, 3.0)
OUTPUT_RESOLUTION=1920x1080
OUTPUT_FPS=30

# --- 6. YouTube Data API v3 ---
YOUTUBE_CLIENT_SECRET_FILE=client_secrets.json
YOUTUBE_TOKEN_FILE=token.json
YOUTUBE_PRIVACY_STATUS=private

# --- 7. Publicación Multi-Plataforma (Instagram Reels, TikTok & Webhooks) ---
# Meta Graph API para Instagram Reels (Cuenta profesional de creador o empresa)
INSTAGRAM_ACCESS_TOKEN=tu_token_de_meta_aqui
INSTAGRAM_BUSINESS_ACCOUNT_ID=tu_id_de_cuenta_business_aqui

# TikTok Content Posting API
TIKTOK_ACCESS_TOKEN=tu_token_de_tiktok_aqui
TIKTOK_CREATOR_ID=tu_creator_id_de_tiktok_aqui

# Webhook multi-plataforma (opcional: Make, n8n, Metricool, Zapier)
SOCIAL_WEBHOOK_URL=

# --- 8. Buffer Multi-Platform Publishing (YouTube Shorts, Instagram Reels, TikTok) ---
# Token de acceso personal de Buffer (Developers > Access Tokens)
BUFFER_ACCESS_TOKEN=tu_buffer_api_token_aqui
# Modo de publicación: shareNow (subir directo y publicar ya) | addToQueue (añadir a la cola) | draft (guardar como borrador)
BUFFER_SHARE_MODE=shareNow


